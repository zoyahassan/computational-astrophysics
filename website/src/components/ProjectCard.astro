---
import type { ProjectMeta } from "../lib/projects";

interface Props {
  project: ProjectMeta;
}

const { project } = Astro.props;
const href = project.status === "published" ? `/projects/${project.slug}` : undefined;
const tags = [...project.topics, ...project.tools].slice(0, 4);
---

<article
  class="group flex h-full flex-col border border-white/15 bg-black/40 p-6 backdrop-blur-md transition hover:border-white/40"
>
  <p class="text-[11px] uppercase tracking-[0.22em] text-white/55">{project.topics[0]}</p>
  <h3 class="mt-3 font-display text-2xl font-light text-white">
    {href ? <a href={href} class="hover:text-white/80">{project.title}</a> : project.title}
  </h3>
  <p class="mt-1 text-sm text-mist/70">{project.subtitle}</p>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-mist/85">{project.description}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <li class="border border-white/15 px-2 py-0.5 text-[11px] uppercase tracking-wider text-white/60">{tag}</li>
      ))
    }
  </ul>
  {
    href ? (
      <a href={href} class="mt-6 text-xs uppercase tracking-[0.18em] text-white/70 group-hover:text-white">
        Read project
      </a>
    ) : (
      <p class="mt-6 text-sm text-mist/50">Coming soon</p>
    )
  }
</article>
