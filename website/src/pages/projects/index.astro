---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { loadProjects } from "../../lib/projects";

const projects = loadProjects();
---

<BaseLayout title="Projects — Zoya Hassan">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <p class="text-xs uppercase tracking-[0.32em] text-white/60">Portfolio</p>
    <h1 class="mt-3 font-display text-5xl font-light text-white">Projects</h1>
    <p class="mt-4 max-w-2xl text-mist/80">
      Computational experiments from textbook physics. Each published project is rendered from its Jupyter
      notebook.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
