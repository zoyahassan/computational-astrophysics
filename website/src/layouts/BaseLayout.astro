---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  overlayNav?: boolean;
}

const { title, description = "Computational astrophysics portfolio", overlayNav = false } = Astro.props;
const githubUrl = "https://github.com/zoyahassan";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@300;400;500;600&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
    ></script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class:list={["z-20", overlayNav ? "absolute inset-x-0 top-0" : "sticky top-0 border-b border-white/10 bg-black/70 backdrop-blur"]}>
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 md:px-10">
        <a href="/" class="text-sm font-medium tracking-[0.18em] text-white uppercase">Zoya Hassan</a>
        <nav class="flex gap-5 text-[11px] font-medium uppercase tracking-[0.16em] text-white/80 md:gap-7">
          <a href="/" class="hover:text-white">Home</a>
          <a href="/about" class="hover:text-white">About</a>
          <a href="/projects" class="hover:text-white">Projects</a>
          <a href={githubUrl} class="hover:text-white" target="_blank" rel="noreferrer">GitHub</a>
        </nav>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-white/10 bg-black py-8 text-center text-xs uppercase tracking-[0.16em] text-white/45">
      <p>Computational astrophysics</p>
    </footer>
  </body>
</html>
